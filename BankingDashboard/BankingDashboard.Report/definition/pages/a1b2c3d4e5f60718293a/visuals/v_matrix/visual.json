{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "v_matrix",
  "position": {
    "x": 340,
    "y": 450,
    "z": 11,
    "height": 260,
    "width": 470,
    "tabOrder": 11
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Branch"
                    }
                  },
                  "Property": "Region"
                }
              },
              "queryRef": "Branch.Region",
              "nativeQueryRef": "Region"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Year"
                }
              },
              "queryRef": "Date.Year",
              "nativeQueryRef": "Year"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Transactions"
                    }
                  },
                  "Property": "Total Deposits"
                }
              },
              "queryRef": "Transactions.Total Deposits",
              "nativeQueryRef": "Total Deposits"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
