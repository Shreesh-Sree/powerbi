{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "v_line",
  "position": {
    "x": 660,
    "y": 185,
    "z": 9,
    "height": 250,
    "width": 600,
    "tabOrder": 9
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Month"
                }
              },
              "queryRef": "Date.Month",
              "nativeQueryRef": "Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Transactions"
                    }
                  },
                  "Property": "Total Deposits"
                }
              },
              "queryRef": "Transactions.Total Deposits",
              "nativeQueryRef": "Total Deposits"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Transactions"
                    }
                  },
                  "Property": "Deposits LY"
                }
              },
              "queryRef": "Transactions.Deposits LY",
              "nativeQueryRef": "Deposits LY"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
