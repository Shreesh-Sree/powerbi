{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "v_bar",
  "position": {
    "x": 20,
    "y": 185,
    "z": 8,
    "height": 250,
    "width": 620,
    "tabOrder": 8
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Branch"
                    }
                  },
                  "Property": "BranchName"
                }
              },
              "queryRef": "Branch.BranchName",
              "nativeQueryRef": "BranchName"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Transactions"
                    }
                  },
                  "Property": "Total Deposits"
                }
              },
              "queryRef": "Transactions.Total Deposits",
              "nativeQueryRef": "Total Deposits"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
