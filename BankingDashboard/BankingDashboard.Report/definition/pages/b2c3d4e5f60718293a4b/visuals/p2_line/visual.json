{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "p2_line",
  "position": {
    "x": 860,
    "y": 185,
    "z": 8,
    "height": 300,
    "width": 400,
    "tabOrder": 8
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Month"
                }
              },
              "queryRef": "Date.Month",
              "nativeQueryRef": "Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Transactions"
                    }
                  },
                  "Property": "Deposits YTD"
                }
              },
              "queryRef": "Transactions.Deposits YTD",
              "nativeQueryRef": "Deposits YTD"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
