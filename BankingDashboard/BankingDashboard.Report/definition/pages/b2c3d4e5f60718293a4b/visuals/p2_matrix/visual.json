{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "p2_matrix",
  "position": {
    "x": 20,
    "y": 500,
    "z": 9,
    "height": 210,
    "width": 1240,
    "tabOrder": 9
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Branch"
                    }
                  },
                  "Property": "Country"
                }
              },
              "queryRef": "Branch.Country",
              "nativeQueryRef": "Country"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Quarter"
                }
              },
              "queryRef": "Date.Quarter",
              "nativeQueryRef": "Quarter"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Transactions"
                    }
                  },
                  "Property": "Total Deposits"
                }
              },
              "queryRef": "Transactions.Total Deposits",
              "nativeQueryRef": "Total Deposits"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Transactions"
                    }
                  },
                  "Property": "Deposits LY"
                }
              },
              "queryRef": "Transactions.Deposits LY",
              "nativeQueryRef": "Deposits LY"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
