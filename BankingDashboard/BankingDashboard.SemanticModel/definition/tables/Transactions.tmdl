table Transactions
	lineageTag: dc5be558-9edf-4d50-9403-51d8dafd43c8

	column TxnID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0f9cfffe-02df-4d59-a2dc-a40faebf2b30
		summarizeBy: none
		sourceColumn: TxnID

	column AccountID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1eff09f7-c2bc-4d8f-b27a-fa8c397fa7fc
		summarizeBy: none
		sourceColumn: AccountID

	column TxnDate
		dataType: dateTime
		formatString: dd-MMM-yyyy
		lineageTag: 85bb8d5e-3a8d-454d-a179-72817594d31a
		summarizeBy: none
		sourceColumn: TxnDate

	column SettlementDate
		dataType: dateTime
		formatString: dd-MMM-yyyy
		lineageTag: 12245d3b-10c0-45c3-82e3-1d4750d80fd8
		summarizeBy: none
		sourceColumn: SettlementDate

	column TxnType
		dataType: string
		lineageTag: 7d79517f-396f-4cd4-b1ee-15bc3e9def80
		summarizeBy: none
		sourceColumn: TxnType

	column Amount
		dataType: double
		formatString: #,0.00
		lineageTag: 6098a0ee-a6a9-4265-8e90-65d987ef7aa0
		summarizeBy: sum
		sourceColumn: Amount

	measure 'Total Deposits' = CALCULATE(SUM(Transactions[Amount]), Transactions[TxnType] = "Deposit")
		formatString: #,0
		lineageTag: 3156f85f-f8e6-4749-84d1-d0ed251518c0
		displayFolder: Base
	measure 'Total Withdrawals' = CALCULATE(SUM(Transactions[Amount]), Transactions[TxnType] = "Withdraw")
		formatString: #,0
		lineageTag: 3a9e72a9-6d2f-420e-8efd-8d243f55ca5f
		displayFolder: Base
	measure 'Total Txn Value' = SUM(Transactions[Amount])
		formatString: #,0
		lineageTag: c201075b-fe9d-4594-b926-730068b52c41
		displayFolder: Base
	measure 'Txn Count' = COUNTROWS(Transactions)
		formatString: #,0
		lineageTag: fe6f0f59-f64d-42d8-92bf-360cbddf97f9
		displayFolder: Base
	measure 'Total Balance' = SUM(Account[Balance])
		formatString: #,0
		lineageTag: 46176bb8-88dd-410a-ba33-e62f40d99ef4
		displayFolder: Base
	measure Accounts = COUNTROWS(Account)
		formatString: #,0
		lineageTag: d8fe9636-527d-4080-adaa-68ff227f6bbb
		displayFolder: Base
	measure Customers = DISTINCTCOUNT(Account[CustomerID])
		formatString: #,0
		lineageTag: 0bd46a4c-fc70-4352-931f-2bed7f691a4b
		displayFolder: Base
	measure 'Avg Balance' = AVERAGE(Account[Balance])
		formatString: #,0
		lineageTag: da475b9f-7615-42ef-8fb5-de38704bfdb2
		displayFolder: Base
	measure 'South Deposits' = CALCULATE([Total Deposits], Branch[Region] = "South")
		formatString: #,0
		lineageTag: af33b0b3-a69e-4e77-b00f-19d4c932d00e
		displayFolder: Region (CALCULATE / ALL)
	measure 'Chennai Deposits' = CALCULATE([Total Deposits], FILTER(Branch, Branch[City] = "Chennai"))
		formatString: #,0
		lineageTag: 60fc291d-2388-4d47-a485-3c5df8b6d315
		displayFolder: Region (CALCULATE / ALL)
	measure 'All Region Deposits' = CALCULATE([Total Deposits], ALL(Branch[Region]))
		formatString: #,0
		lineageTag: 3e9109e0-2dba-4d63-a4cd-161b5d4cf66d
		displayFolder: Region (CALCULATE / ALL)
	measure 'Region Share %' = DIVIDE([Total Deposits], [All Region Deposits])
		formatString: 0.0%
		lineageTag: 21400aa1-87e2-4928-be38-a41a950c800f
		displayFolder: Region (CALCULATE / ALL)
	measure 'Deposits YTD' = TOTALYTD([Total Deposits], 'Date'[Date])
		formatString: #,0
		lineageTag: 9f061e7f-c96f-4f2f-b565-8e52efa4c339
		displayFolder: Time Intelligence
	measure 'Deposits MTD' = TOTALMTD([Total Deposits], 'Date'[Date])
		formatString: #,0
		lineageTag: 4d31a35c-1b8b-4b2b-aa66-136cabcd65d3
		displayFolder: Time Intelligence
	measure 'Deposits QTD' = TOTALQTD([Total Deposits], 'Date'[Date])
		formatString: #,0
		lineageTag: 17f0297d-bacd-4fe8-a00f-68b0ca826f3d
		displayFolder: Time Intelligence
	measure 'Deposits LY' = CALCULATE([Total Deposits], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: #,0
		lineageTag: ef743cec-c536-4a2a-8ce1-690350a2dd57
		displayFolder: Time Intelligence
	measure 'YoY Growth %' = DIVIDE([Total Deposits] - [Deposits LY], [Deposits LY])
		formatString: 0.0%
		lineageTag: 68e08b8c-42ef-4f10-b6f4-61e9c327406d
		displayFolder: Time Intelligence
	measure 'Deposits by Settlement Date' = CALCULATE([Total Deposits], USERELATIONSHIP('Date'[Date], Transactions[SettlementDate]))
		formatString: #,0
		lineageTag: 16446d7c-62b2-49fa-af95-ab15c75c23cf
		displayFolder: Settlement (USERELATIONSHIP)
	measure 'Avg Settlement Days' = AVERAGEX(Transactions, DATEDIFF(Transactions[TxnDate], Transactions[SettlementDate], DAY))
		formatString: 0.00
		lineageTag: 7dd279c1-8753-4710-a9a2-23c40025a496
		displayFolder: Settlement (USERELATIONSHIP)
	measure 'Selected Region' = SELECTEDVALUE(Branch[Region], "All Regions")
		formatString: 0
		lineageTag: 599dad08-1a03-40e1-bbe1-d48aca31e3ea
		displayFolder: Dynamic
	measure 'Report Title' = "Banking Performance: " & [Selected Region] & " | Deposits " & FORMAT([Total Deposits], "#,0")
		formatString: 0
		lineageTag: f4c8da13-ca41-442c-8095-bb751947d4b7
		displayFolder: Dynamic

	partition Transactions = m
		mode: import
		source =
				let
					Source = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
					Table = Table.FromRows(Source, {"TxnID", "AccountID", "TxnDate", "SettlementDate", "TxnType", "Amount"}),
					Typed = Table.TransformColumnTypes(Table, {{"TxnID", Int64.Type}, {"AccountID", Int64.Type}, {"TxnDate", type date}, {"SettlementDate", type date}, {"TxnType", type text}, {"Amount", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
