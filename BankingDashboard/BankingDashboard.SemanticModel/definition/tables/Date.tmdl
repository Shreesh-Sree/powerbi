table Date
	dataCategory: Time
	lineageTag: 036a9b96-89ba-4f87-8b05-40db8838baf7

	column Date
		dataType: dateTime
		isKey
		formatString: dd-MMM-yyyy
		lineageTag: 97b7a20b-2a0b-4e03-913c-ee3a8ec3c898
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 5a79495f-d987-419c-ac93-2fe5a015efad
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		lineageTag: 1e8b455c-e011-40e5-901a-0d6a8080e137
		summarizeBy: none
		sourceColumn: Quarter

	column MonthNo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4e035df5-f594-4938-84fd-4fe32f691921
		summarizeBy: none
		sourceColumn: MonthNo

	column Month
		dataType: string
		lineageTag: 98a92e5a-6b71-4658-a911-7bb054ec036e
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: MonthNo


	partition Date = m
		mode: import
		source =
				let
					Dates = List.Dates(#date(2024,1,1), 731, #duration(1,0,0,0)),
					T = Table.TransformColumnTypes(Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}), {{"Date", type date}}),
					Y = Table.AddColumn(T, "Year", each Date.Year([Date]), Int64.Type),
					Q = Table.AddColumn(Y, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
					MN = Table.AddColumn(Q, "MonthNo", each Date.Month([Date]), Int64.Type),
					Mo = Table.AddColumn(MN, "Month", each Text.Start(Date.MonthName([Date]), 3), type text)
				in
					Mo

	annotation PBI_ResultType = Table
